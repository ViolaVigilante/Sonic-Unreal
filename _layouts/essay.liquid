---
layout: default
---

<head>
    <style>
        .btn {
            cursor: pointer;
            -webkit-transition-property: all;
            -webkit-transition-duration: 0.5s;
            -webkit-transition-timing-function: ease;
        }

        .btn:hover{
            transform: scale(1.05);
            background-color: bisque;
        }

        .method-button {
            background: transparent;
            border: none;
            padding: 0;
            cursor: pointer;
            transition: transform 0.3s ease, filter 0.3s ease;
            filter: drop-shadow(15px 10px 4px #3C1B38);
        }

        .method-button img {
            display: block;
            width: min(10vw, 160px);
            height: auto;
            max-width: 100%;
        }

        .method-button:hover {
            transform: scale(1.1);
            filter: drop-shadow(28px 23px 8px #3C1B38);
        }

        .method-label {
            position: absolute;
            inset: 50% auto auto 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            pointer-events: none;
            color: white;
            font-weight: bold;
            text-shadow: 0 0 6px rgba(0,0,0,0.6);
            transition: opacity 0.2s ease; 
        }

        .method-button:hover .method-label {
            opacity: 1;
        }

        body {
            background-color: #EAE9D7;
        }
    </style>

    <script>
        let easyReadingModeOn = false;
        const citationMarkerPositions = [];

        function removeCitationMarker(element) {
            const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
            let textNode;

            while ((textNode = walker.nextNode())) {
                const markerIndex = textNode.nodeValue.indexOf("⚑");
                if (markerIndex !== -1) {
                    const text = textNode.nodeValue;
                    textNode.nodeValue = text.slice(0, markerIndex) + text.slice(markerIndex + 1);
                    return { textNode, markerIndex };
                }
            }

            return null;
        }

        function restoreCitationMarker(markerInfo) {
            if (!markerInfo) {
                return;
            }

            const { textNode, markerIndex } = markerInfo;
            const text = textNode.nodeValue || "";
            textNode.nodeValue = text.slice(0, markerIndex) + "⚑" + text.slice(markerIndex);
        }

        function easyReadingFunction() {
            const citationList = document.getElementsByClassName("popup-citation");

            if (easyReadingModeOn === false) {
                for (let i = 0; i < citationList.length; i++) {
                    citationList[i].style.background = "none";
                    citationMarkerPositions[i] = removeCitationMarker(citationList[i]);
                }
                const hyperlinkList = document.getElementsByClassName("popup-hyperlink");
                for (let i = 0; i < hyperlinkList.length; i++) {
                    hyperlinkList[i].style.background = "none";
                    hyperlinkList[i].style.fontWeight = "normal";
                }
                const commentList = document.getElementsByClassName("popup-comment");
                for (let i = 0; i < commentList.length; i++) {
                    commentList[i].style.background = "none";
                }
            } else {
                for (let i = 0; i < citationList.length; i++) {
                    citationList[i].style.background = "#d2d8da";
                    restoreCitationMarker(citationMarkerPositions[i]);
                }
                citationMarkerPositions.length = 0;
                const hyperlinkList = document.getElementsByClassName("popup-hyperlink");
                for (let i = 0; i < hyperlinkList.length; i++) {
                    hyperlinkList[i].style.background = "#eed3e2";
                    hyperlinkList[i].style.fontWeight = "bold";
                }
                const commentList = document.getElementsByClassName("popup-comment");
                for (let i = 0; i < commentList.length; i++) {
                    commentList[i].style.background = "#b1e7d1";
                }
            }
            easyReadingModeOn = !easyReadingModeOn;
            return true;
        }
    </script>
</head>

<article {% if page.feature-img %}class="feature-image"{% endif %}>
    <header id="main" style="background-image: url('{{ page.feature-img | relative_url }}')">
        <div class="title-padder">
            {% if page.hide_title %}
                <div class="feature-image-padding"></div>
            {% else %}
                <h1 id="{{ page.title | default: "" | cgi_escape }}" class="title"> {{ page.title }}</h1>
                {% if page.subtitle %}
                    <h2 class="subtitle">{{ page.subtitle }}</h2>
                {% endif %}
            {% endif %}
        </div>
    </header>

    <!-- Tag list for portfolio -->
    {% capture tag_list %}{{ page.tags | join: "|" }}{% endcapture %}
    {% capture _tags %}{% include default/tags_list.liquid tags=tag_list %}{% endcapture %}
    {{ _tags | split: " " | join: " " }}

    <section class="post-content">
    {% if page.bootstrap %}
        <div class="bootstrap-iso">
            {% endif %}
            {{ content }}
            {% if page.bootstrap %}
        </div>
        {% endif %}
    </section>

    <!-- Fetch Text for Method Overlay -->
    {% if page.method-sidebar %}
        {% assign method_file = page.permalink | prepend: "method" %}
        {% capture method_content %}{% include {{ method_file }} %}{% endcapture %}

        <!-- Bootstrap Offcanvas for Method -->
        <div class="method-button-container" style="position: fixed; right: 4%; bottom: 50%; z-index: 1000;">
            <button class="method-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#method-text" aria-controls="method-text">
                <img src="{{ '/assets/img/disco_button.png' | relative_url }}" alt="Method button">
                <span class="method-label">Method</span>
            </button>
        </div>
        <div class="offcanvas offcanvas-end" tabindex="-1" id="method-text" aria-labelledby="methodTextLabel" style="background: #EAE9D7">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="methodTextLabel">Method</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                {{ method_content | markdownify }}
            </div>
        </div>
    {% endif %}

    <!-- Bootstrap Offcanvas for breadcrumbs -->
    <div class="breadcrumb-button-container" style="position: fixed; left: 2%; bottom: 5%; z-index: 1000;">
        <button class="breadcrumb-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
            Recently Visited Pages
        </button>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Recently Visited Pages</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div>
            {% include breadcrumbs2.html %}
            </div>
        </div>
    </div>

    <!-- Easy Reading Mode toggle -->
    <div class="easy-reading-mode-toggle" style="position: fixed; right: 2%; bottom: 5%; z-index: 1000;">
        <button class="easy-reading-mode-button" type="button" onclick="easyReadingFunction()">
            Easy Reading Mode
        </button>
    </div>

    <!-- Looks for which track(s) a page is a part of, then initializes colored next/previous page buttons as appropriate for each track -->
    <section class="next-previous-page-buttons">
        <div class="esports-track">
            {% if page.esports-track %}
                {% if page.next-esports-page and page.previous-esports-page %}
                    {% include buttons/esports_next_and_previous.html %}
                {% elsif page.next-esports-page %}
                    {% include buttons/esports_next_page.html %}
                {% elsif page.previous-esports-page %}
                    {% include buttons/esports_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
        <div class="nightlife-track">
            {% if page.nightlife-track %}
                {% if page.next-nightlife-page and page.previous-nightlife-page %}
                    {% include buttons/nightlife_next_and_previous.html %}
                {% elsif page.next-nightlife-page %}
                    {% include buttons/nightlife_next_page.html %}
                {% elsif page.previous-nightlife-page %}
                    {% include buttons/nightlife_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
        <div class="virtual-concerts-track">
            {% if page.virtual-concerts-track %}
                {% if page.next-virtual-concerts-page and page.previous-virtual-concerts-page %}
                    {% include buttons/virtual_concerts_next_and_previous.html %}
                {% elsif page.next-virtual-concerts-page %}
                    {% include buttons/virtual_concerts_next_page.html %}
                {% elsif page.previous-virtual-concerts-page %}
                    {% include buttons/virtual_concerts_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
        <div class="immersion-track">
            {% if page.immersion-track %}
                {% if page.next-immersion-page and page.previous-immersion-page %}
                    {% include buttons/immersion_next_and_previous.html %}
                {% elsif page.next-immersion-page %}
                    {% include buttons/immersion_next_page.html %}
                {% elsif page.previous-immersion-page %}
                    {% include buttons/immersion_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
        <div class="liveness-track">
            {% if page.liveness-track %}
                {% if page.next-liveness-page and page.previous-liveness-page %}
                    {% include buttons/liveness_next_and_previous.html %}
                {% elsif page.next-liveness-page %}
                    {% include buttons/liveness_next_page.html %}
                {% elsif page.previous-liveness-page %}
                    {% include buttons/liveness_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
        <div class="virtuality-track">
            {% if page.virtuality-track %}
                {% if page.next-virtuality-page and page.previous-virtuality-page %}
                    {% include buttons/virtuality_next_and_previous.html %}
                {% elsif page.next-virtuality-page %}
                    {% include buttons/virtuality_next_page.html %}
                {% elsif page.previous-virtuality-page %}
                    {% include buttons/virtuality_previous_page.html %}
                {% endif %}
            {% endif %}
        </div>
    </section>
</article>

<script>
    const popoverTriggerList = document.querySelectorAll('[data-bs-toggle="popover"]');
    const popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl));
</script>